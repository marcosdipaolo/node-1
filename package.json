{
  "name": "temp1",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --ext .ts --ignore-pattern dist/** --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \".vscode/**/*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --testNamePattern unit",
    "test:feature": "vitest run --testNamePattern feature",
    "typeorm-dev": "node --import tsx ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "typeorm-dist": "typeorm -d dist/data-source.js",
    "migration:generate:dev": "pnpm typeorm-dev migration:generate",
    "migration:run:dev": "pnpm typeorm-dev migration:run",
    "migration:revert:dev": "pnpm typeorm-dev migration:revert",
    "migration:run": "pnpm typeorm-dist migration:run",
    "migration:revert": "pnpm typeorm-dist migration:revert",
    "prod": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/supertest": "^7.2.0",
    "bcryptjs": "^2.4.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.2",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.2.2",
    "typeorm": "^0.3.28",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0"
  },
  "packageManager": "pnpm@11.0.9"
}
